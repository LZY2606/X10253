<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PowerSequencer</RootNamespace>
    <AssemblyName>PowerSequencer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="casepack\*.json" />
    <Content Include="casepack\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
