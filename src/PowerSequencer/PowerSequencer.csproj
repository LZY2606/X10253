<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PowerSequencer</RootNamespace>
    <AssemblyName>PowerSequencer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.22" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\casepack\**\*.json" CopyToOutputDirectory="PreserveNewest" Link="casepack\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
